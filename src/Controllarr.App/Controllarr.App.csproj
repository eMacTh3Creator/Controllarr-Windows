<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Controllarr.App</RootNamespace>
    <AssemblyName>Controllarr</AssemblyName>
    <ApplicationIcon>Assets\controllarr.ico</ApplicationIcon>
    <Version>2.1.18</Version>
    <Company>Controllarr</Company>
    <Product>Controllarr</Product>
    <Description>Native Windows BitTorrent client for media server workflows</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Controllarr.Core\Controllarr.Core.csproj" />
  </ItemGroup>

  <!-- The app icon must also ship as a WPF resource so the window + tray icon
       (pack URI /Assets/controllarr.ico) resolve at runtime; ApplicationIcon
       alone only sets the .exe's shell icon. -->
  <ItemGroup>
    <Resource Include="Assets\controllarr.ico" />
  </ItemGroup>

  <!-- Embed the no-build browser Web UI INTO the executable so the published
       single-file exe is genuinely self-contained. The app extracts these to
       %AppData%\Controllarr\WebUI on boot, and the embedded HTTP server serves
       them from there. (No loose WebUI folder needs to ship beside the exe.) -->
  <ItemGroup>
    <EmbeddedResource Include="WebUI\**\*" />
  </ItemGroup>

  <PropertyGroup>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
  </ItemGroup>

</Project>
