<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:h="clr-namespace:Controllarr.App.Helpers">
    <DataTemplate x:Key="RssViewTemplate">
        <Grid Margin="24" h:ValidationGate.Enabled="True" h:DirtyTracker.Command="{Binding MarkSettingsModifiedCommand}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="RSS / watch folder" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Automatic imports with saved filters, persistent duplicate history and bounded background checks." Style="{StaticResource SecondaryText}" Margin="0,8,0,12"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Add feed" Command="{Binding AddRssFeedCommand}" Margin="0,0,8,0"/>
                    <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" IsEnabled="{Binding Path=(h:ValidationGate.IsValid), RelativeSource={RelativeSource AncestorType=Grid}}" Style="{StaticResource AccentButton}" Margin="0,0,8,0"/>
                    <Button Content="Check now" Command="{Binding CheckRssCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding SaveFeedbackText}" Margin="0,8,0,0" Foreground="{StaticResource AccentLightBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding RssStatus}" Margin="0,4,0,0" Style="{StaticResource SecondaryText}"/>
            </StackPanel>
            <TabControl Grid.Row="1">
                <TabItem Header="Feeds and rules">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <GroupBox Header="Watch folder">
                                <StackPanel>
                                    <TextBlock Text="Absolute folder path; blank disables watching. Stable .torrent files are imported using the default save folder and are left in place." TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding Settings.WatchFolder, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </GroupBox>
                            <ItemsControl ItemsSource="{Binding Settings.RssFeeds}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <GroupBox Header="{Binding Name}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" Margin="0,0,20,0"/>
                                                <CheckBox Content="Auto-download matched entries" IsChecked="{Binding AutoDownload}"/>
                                            </StackPanel>
                                            <TextBlock Text="Name" Margin="0,10,0,4"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="Feed URL (HTTP / HTTPS)" Margin="0,10,0,4"/><TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="Include title regex (blank matches all)" Margin="0,10,0,4"/><TextBox Text="{Binding IncludePattern, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="Exclude title regex (blank excludes nothing)" Margin="0,10,0,4"/><TextBox Text="{Binding ExcludePattern, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="Category" Margin="0,10,0,4"/><TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="Save folder override (optional, absolute)" Margin="0,10,0,4"/><TextBox Text="{Binding SavePath, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="Check interval in minutes (1-1440)" Margin="0,10,0,4"/>
                                            <TextBox Text="{Binding IntervalMinutes, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="120" HorizontalAlignment="Left"/>
                                            <Button Content="Remove feed" Command="{Binding DataContext.RemoveRssFeedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                        </StackPanel>
                                    </GroupBox>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Recent entries">
                    <DataGrid ItemsSource="{Binding RssEntries}" EnableRowVirtualization="True"><DataGrid.Columns>
                        <DataGridTextColumn Header="Feed" Binding="{Binding Feed}" Width="140"/>
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="210"/>
                        <DataGridTextColumn Header="Checked" Binding="{Binding CheckedAt, StringFormat={}{0:g}}" Width="150"/>
                    </DataGrid.Columns></DataGrid>
                </TabItem>
            </TabControl>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
