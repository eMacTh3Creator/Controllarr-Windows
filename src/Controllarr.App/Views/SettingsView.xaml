<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Controllarr.App.ViewModels"
                    xmlns:persistence="clr-namespace:Controllarr.Core.Persistence;assembly=Controllarr.Core"
                    xmlns:h="clr-namespace:Controllarr.App.Helpers">

    <DataTemplate x:Key="SettingsViewTemplate">
        <DockPanel h:ValidationGate.Enabled="True">
            <!-- ══ Bottom action bar ══════════════════════════════ -->
            <Border DockPanel.Dock="Bottom"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding SaveFeedbackText}"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Margin="0,0,16,0"/>
                    <Button Content="Revert"
                            Command="{Binding RevertSettingsCommand}"
                            Margin="0,0,8,0"/>
                    <Button Style="{StaticResource AccentButton}"
                            Content="Save Settings"
                            IsEnabled="{Binding Path=(h:ValidationGate.IsValid), RelativeSource={RelativeSource AncestorType=DockPanel}}"
                            ToolTip="Fix any highlighted invalid inputs before saving."
                            Command="{Binding SaveSettingsCommand}"/>
                </StackPanel>
            </Border>

            <!-- ══ Scrollable settings form ══════════════════════ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="24,20">
                <StackPanel MaxWidth="720"
                            h:DirtyTracker.Command="{Binding MarkSettingsModifiedCommand}">

                    <TextBlock Text="Settings" Style="{StaticResource HeaderText}"
                               Margin="0,0,0,20"/>
                    <TextBlock Text="Fix any red-highlighted inputs before saving. Server address and listening-port changes require a restart."
                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <!-- ── General ──────────────────────────────── -->
                    <GroupBox Header="General">
                        <StackPanel>
                            <CheckBox Content="Launch Controllarr at Windows startup"
                                      IsChecked="{Binding LaunchAtStartup}"
                                      Margin="0,0,0,16"/>
                            <CheckBox Content="Close window to the system tray (keep transfers running)"
                                      IsChecked="{Binding Settings.UiPreferences.CloseToTray}" Margin="0,0,0,8"/>
                            <CheckBox Content="Start with the window hidden"
                                      IsChecked="{Binding Settings.UiPreferences.StartMinimized}" Margin="0,0,0,8"/>
                            <CheckBox Content="Automatically check for updates"
                                      IsChecked="{Binding Settings.UiPreferences.AutomaticUpdateChecks}" Margin="0,0,0,16"/>

                            <TextBlock Text="Default Save Path" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Settings.DefaultSavePath, UpdateSourceTrigger=PropertyChanged}"
                                         Grid.Column="0"/>
                                <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0"
                                        Style="{StaticResource SubtleButton}"
                                        Command="{Binding BrowseSavePathCommand}"/>
                            </Grid>

                            <CheckBox Content="Create per-torrent subfolders for uncategorized downloads"
                                      IsChecked="{Binding Settings.CreateTorrentSubfolders}" Margin="0,12,0,6"/>
                            <TextBlock Text="Categories have their own subfolder checkbox. No trailing backslash is needed. Changes apply to new torrents only."
                                       TextWrapping="Wrap" Style="{StaticResource SecondaryText}"/>

                            <TextBlock Text="Listen Port Range" Style="{StaticResource SecondaryText}" Margin="0,16,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding Settings.ListenPortRangeStart, UpdateSourceTrigger=PropertyChanged}"
                                         Width="80"/>
                                <TextBlock Text=" - " VerticalAlignment="Center" Margin="8,0"/>
                                <TextBox Text="{Binding Settings.ListenPortRangeEnd, UpdateSourceTrigger=PropertyChanged}"
                                         Width="80"/>
                            </StackPanel>
                            <TextBlock Text="Preferred forwarded port (blank for automatic)" Style="{StaticResource SecondaryText}" Margin="0,16,0,4"/>
                            <TextBox Text="{Binding Settings.PreferredListenPort, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock Text="Restart after changing the preferred port or server bind address." Style="{StaticResource SecondaryText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Connections and discovery">
                        <StackPanel>
                            <TextBlock Text="Global peer connection limit" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Settings.ConnectionLimits.GlobalMaxConnections, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock Text="Download connection reserve (0-90%, 0 = off)" Style="{StaticResource SecondaryText}" Margin="0,12,0,4"/>
                            <TextBox Text="{Binding Settings.ConnectionLimits.DownloadReservePercent, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock Text="While downloads are active, ordinary seeds share the remaining connection budget. Extra seeds wait automatically, even if active-torrent queueing is off. Forced seeds retain their caps; this is headroom, not a guarantee of seed availability." TextWrapping="Wrap" Style="{StaticResource SecondaryText}" Margin="0,8"/>
                            <TextBlock Text="Default connections per torrent (1-10000)" Style="{StaticResource SecondaryText}" Margin="0,12,0,4"/>
                            <TextBox Text="{Binding Settings.ConnectionLimits.MaxConnectionsPerTorrent, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock Text="Default upload slots per torrent (2-1000, not a global slot cap)" Style="{StaticResource SecondaryText}" Margin="0,12,0,4"/>
                            <TextBox Text="{Binding Settings.ConnectionLimits.GlobalMaxUploadSlots, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock Text="Watch the status bar's Peers used/limit counter. If full, reduce active seeds or per-torrent connections before raising the global cap. More connections cost CPU, memory and disk work." TextWrapping="Wrap" Style="{StaticResource SecondaryText}" Margin="0,8,0,12"/>
                            <CheckBox Content="Enable DHT" IsChecked="{Binding Settings.PeerDiscovery.DhtEnabled}" Margin="0,4"/>
                            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,8">
                                <Run Text="DHT runtime: "/><Run Text="{Binding SessionStats.DhtState, Mode=OneWay}"/>
                                <Run Text=" | nodes: "/><Run Text="{Binding SessionStats.DhtNodes, Mode=OneWay}"/>
                            </TextBlock>
                            <CheckBox Content="Enable peer exchange (PEX)" IsChecked="{Binding Settings.PeerDiscovery.PexEnabled}" Margin="0,4"/>
                            <CheckBox Content="Enable local peer discovery (LSD)" IsChecked="{Binding Settings.PeerDiscovery.LsdEnabled}" Margin="0,4"/>
                            <TextBlock Text="DHT works through the enforced VPN adapter, including tunnel-bound bootstrap DNS. A blocklist also filters DHT nodes. SOCKS5 disables DHT and UDP trackers (UDP ASSOCIATE is not supported). Local discovery and router port mapping stay disabled in protected modes. Private torrents never use DHT. A preferred forwarded port stays fixed during stalls." TextWrapping="Wrap" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Queue and global speed limits">
                        <StackPanel>
                            <CheckBox Content="Manage the active torrent queue" IsChecked="{Binding Settings.TorrentQueueing.Enabled}"/>
                            <TextBlock Text="Queue limits are enforced independently of library size. 0 means no ordinary active torrents in that class. Force-start bypasses queue limits, not VPN or disk guards." TextWrapping="Wrap" Style="{StaticResource SecondaryText}" Margin="0,8"/>
                            <TextBlock Text="Maximum active downloads"/><TextBox Text="{Binding Settings.TorrentQueueing.MaxActiveDownloads, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="120" HorizontalAlignment="Left" Margin="0,4,0,8"/>
                            <TextBlock Text="Maximum active seeds"/><TextBox Text="{Binding Settings.TorrentQueueing.MaxActiveSeeds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="120" HorizontalAlignment="Left" Margin="0,4,0,8"/>
                            <TextBlock Text="Maximum active total"/><TextBox Text="{Binding Settings.TorrentQueueing.MaxActiveTotal, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="120" HorizontalAlignment="Left" Margin="0,4,0,8"/>
                            <TextBlock Text="Global download limit (KiB/s, 0 = unlimited)"/><TextBox Text="{Binding Settings.GlobalDownloadKBps, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="120" HorizontalAlignment="Left" Margin="0,4,0,8"/>
                            <TextBlock Text="Global upload limit (KiB/s, 0 = unlimited)"/><TextBox Text="{Binding Settings.GlobalUploadKBps, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="120" HorizontalAlignment="Left" Margin="0,4,0,8"/>
                            <TextBlock Text="Scheduled limits override these during a matching window. Outside that window, these global limits apply." Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- ── WebUI ───────────────────────────────── -->
                    <GroupBox Header="WebUI">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Host" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                            <TextBox Grid.Row="1" Grid.Column="0"
                                     Text="{Binding Settings.WebUIHost, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Port" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                            <TextBox Grid.Row="1" Grid.Column="2"
                                     Text="{Binding Settings.WebUIPort, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Username" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                            <TextBox Grid.Row="3" Grid.Column="0"
                                     Text="{Binding Settings.WebUIUsername, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Password" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                            <PasswordBox Grid.Row="3" Grid.Column="2"
                                         h:PasswordBinding.Password="{Binding Settings.WebUIPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </GroupBox>

                    <!-- ── Seeding Policy ──────────────────────── -->
                    <GroupBox Header="Seeding Policy">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Global Max Ratio" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                                <TextBox Grid.Row="1" Grid.Column="0"
                                         Text="{Binding Settings.GlobalMaxRatio, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Global Max Seed Time (min)" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                                <TextBox Grid.Row="1" Grid.Column="2"
                                         Text="{Binding Settings.GlobalMaxSeedingTimeMinutes, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Seed Limit Action" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                                <ComboBox Grid.Row="4" Grid.Column="0"
                                          SelectedItem="{Binding Settings.SeedLimitAction}"
                                          ItemsSource="{Binding Source={x:Static vm:SeedLimitActionValues.All}}"/>

                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Minimum Seed Time (min)" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                                <TextBox Grid.Row="4" Grid.Column="2"
                                         Text="{Binding Settings.MinimumSeedTimeMinutes, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- ── Health Monitor ──────────────────────── -->
                    <GroupBox Header="Health Monitor">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Stall Threshold (minutes)" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Settings.HealthStallMinutes, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,2">
                                    <CheckBox Content="Auto-reannounce on stall"
                                              IsChecked="{Binding Settings.HealthReannounceOnStall}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- ── VPN Protection ──────────────────────── -->
                    <GroupBox Header="VPN Protection">
                        <StackPanel>
                            <CheckBox Content="Enforce VPN-only torrent traffic"
                                      IsChecked="{Binding Settings.VpnEnabled}"
                                      Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Always fail-closed when enabled: torrent peers, trackers, webseeds and DNS use the selected IPv4 adapter. LAN WebUI/API traffic stays separate. Also enable your VPN provider's kill switch as defense in depth." TextWrapping="Wrap" Style="{StaticResource SecondaryText}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Interface Prefix" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                                <TextBox Grid.Row="3" Grid.Column="0"
                                         Text="{Binding Settings.VpnInterfacePrefix, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Monitor Interval (sec)" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                                <TextBox Grid.Row="3" Grid.Column="2"
                                         Text="{Binding Settings.VpnMonitorIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <TextBlock Text="VPN adapter (choose your actual tunnel, not the Ethernet/Wi-Fi adapter)" Style="{StaticResource SecondaryText}" Margin="0,16,0,4"/>
                            <ComboBox ItemsSource="{Binding NetworkAdapters}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding Settings.VpnInterfaceId, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="Refresh adapters" Command="{Binding RefreshNetworkAdaptersCommand}" HorizontalAlignment="Left" Margin="0,8"/>
                            <TextBlock Text="{Binding TorrentNetworkStatusText}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Margin="0,8"/>
                            <TextBlock Text="PIA, NordLynx/NordVPN, Proton, Mullvad, Surfshark, ExpressVPN and generic OpenVPN/WireGuard/Wintun tunnels are recognized automatically. Multiple active tunnels require an explicit selection. VPN/proxy/blocklist changes require restart; missing adapters never fall back to Ethernet/Wi-Fi. DNS uses bound UDP with TCP fallback; numeric public resolvers are also tried through the tunnel, never system DNS." TextWrapping="Wrap" Style="{StaticResource SecondaryText}"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Torrent encryption, proxy and IP filtering">
                        <StackPanel>
                            <TextBlock Text="Peer encryption policy (not a replacement for a VPN)" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                            <ComboBox SelectedValuePath="Content" SelectedValue="{Binding Settings.TorrentNetwork.Encryption}" Width="160" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Prefer"/><ComboBoxItem Content="Require"/><ComboBoxItem Content="Disable"/>
                            </ComboBox>
                            <CheckBox Content="Route all outgoing torrent TCP connections through SOCKS5" IsChecked="{Binding Settings.TorrentNetwork.ProxyEnabled}" Margin="0,16,0,8"/>
                            <TextBlock Text="SOCKS5 server IPv4 address" Style="{StaticResource SecondaryText}"/><TextBox Text="{Binding Settings.TorrentNetwork.ProxyHost, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
                            <TextBlock Text="SOCKS5 port" Style="{StaticResource SecondaryText}"/><TextBox Text="{Binding Settings.TorrentNetwork.ProxyPort, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="120" HorizontalAlignment="Left" Margin="0,4,0,8"/>
                            <TextBlock Text="Username (blank for no authentication)" Style="{StaticResource SecondaryText}"/><TextBox Text="{Binding Settings.TorrentNetwork.ProxyUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
                            <TextBlock Text="Password (DPAPI-encrypted at rest, no permission prompts)" Style="{StaticResource SecondaryText}"/><PasswordBox h:PasswordBinding.Password="{Binding Settings.TorrentNetwork.ProxyPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
                            <TextBlock Text="Hostname resolution is remote. Incoming peers and UDP trackers are disabled; failures never connect directly. With an IP blocklist, hostname tracker/webseed destinations are rejected because their remote addresses cannot be verified. SOCKS5 authentication is not encrypted on the wire: use VPN binding with untrusted networks." TextWrapping="Wrap" Style="{StaticResource SecondaryText}"/>
                            <TextBlock Text="IP blocklist file (blank disables filtering)" Style="{StaticResource SecondaryText}" Margin="0,16,0,4"/>
                            <TextBox Text="{Binding Settings.TorrentNetwork.BlocklistPath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="Choose blocklist..." Command="{Binding BrowseTorrentBlocklistCommand}" HorizontalAlignment="Left" Margin="0,8"/>
                            <TextBlock Text="Local text file: one IPv4/IPv6 address or CIDR per line, # comments, up to 100000 entries / 5 MiB. Restart after editing the file. This filters torrent peers, tracker and webseed destinations, not LAN API clients." TextWrapping="Wrap" Style="{StaticResource SecondaryText}"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- ── Disk Space ──────────────────────────── -->
                    <GroupBox Header="Disk Space">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Minimum Free Space (GB)" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                            <TextBox Grid.Row="1" Grid.Column="0"
                                     Text="{Binding Settings.DiskSpaceMinimumGB, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Monitor Path" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                            <Grid Grid.Row="1" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding Settings.DiskSpaceMonitorPath, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0"
                                        Style="{StaticResource SubtleButton}"
                                        Command="{Binding BrowseDiskMonitorPathCommand}"/>
                            </Grid>
                        </Grid>
                    </GroupBox>

                    <!-- ── *arr Integration ────────────────────── -->
                    <GroupBox Header="*arr Integration">
                        <StackPanel>
                            <TextBlock Text="Configured endpoints:" Style="{StaticResource SecondaryText}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Settings.ArrEndpoints}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8"
                                                Background="{StaticResource BackgroundBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock>
                                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <Run Text=" - " Foreground="{StaticResource TextMutedBrush}"/>
                                                        <Run Text="{Binding Kind, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding BaseURL}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource SubtleButton}"
                                                        Content="Remove"
                                                        Foreground="{StaticResource ErrorBrush}"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.RemoveArrEndpointCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Add Endpoint" HorizontalAlignment="Left" Margin="0,4,0,0"
                                    Command="{Binding AddArrEndpointCommand}"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- ── Bandwidth Schedule ──────────────────── -->
                    <GroupBox Header="Bandwidth Schedule">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Settings.BandwidthSchedule}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8"
                                                Background="{StaticResource BackgroundBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock>
                                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <Run Text="{Binding Enabled, Mode=OneWay, StringFormat=' ({0})'}"
                                                             Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0">
                                                        <Run Text="{Binding StartHour, Mode=OneWay, StringFormat='{}{0:D2}'}"/>:<Run Text="{Binding StartMinute, Mode=OneWay, StringFormat='{}{0:D2}'}"/>
                                                        <Run Text=" - "/>
                                                        <Run Text="{Binding EndHour, Mode=OneWay, StringFormat='{}{0:D2}'}"/>:<Run Text="{Binding EndMinute, Mode=OneWay, StringFormat='{}{0:D2}'}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource SubtleButton}"
                                                        Content="Remove"
                                                        Foreground="{StaticResource ErrorBrush}"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.RemoveBandwidthRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Add Schedule Rule" HorizontalAlignment="Left" Margin="0,4,0,0"
                                    Command="{Binding AddBandwidthRuleCommand}"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- ── Recovery Rules ──────────────────────── -->
                    <GroupBox Header="Recovery Rules">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Settings.RecoveryRules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8"
                                                Background="{StaticResource BackgroundBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock>
                                                        <Run Text="Trigger: " Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        <Run Text="{Binding Trigger, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <Run Text="  Action: " Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        <Run Text="{Binding Action, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0">
                                                        <Run Text="Delay: "/>
                                                        <Run Text="{Binding DelayMinutes, Mode=OneWay}"/>
                                                        <Run Text=" min"/>
                                                        <Run Text="  Enabled: "/>
                                                        <Run Text="{Binding Enabled, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource SubtleButton}"
                                                        Content="Remove"
                                                        Foreground="{StaticResource ErrorBrush}"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.RemoveRecoveryRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Add Recovery Rule" HorizontalAlignment="Left" Margin="0,4,0,0"
                                    Command="{Binding AddRecoveryRuleCommand}"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- ── Backup / Restore ────────────────────── -->
                    <GroupBox Header="Backup / Restore">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Export Backup"
                                    Command="{Binding ExportBackupCommand}"
                                    Margin="0,0,12,0"/>
                            <Button Content="Import Backup"
                                    Command="{Binding ImportBackupCommand}"/>
                            <Separator Margin="16,0" Width="1" Background="{StaticResource BorderBrush}"/>
                            <Button Content="Open WebUI"
                                    Command="{Binding OpenWebUICommand}"
                                    Style="{StaticResource SubtleButton}"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Bottom spacer -->
                    <Border Height="40"/>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>

</ResourceDictionary>
