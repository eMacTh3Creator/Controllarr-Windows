<Application x:Class="Controllarr.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Controllarr.App.Helpers"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:SizeConverter x:Key="SizeConverter"/>
            <conv:SpeedConverter x:Key="SpeedConverter"/>
            <conv:EtaConverter x:Key="EtaConverter"/>
            <conv:ProgressPercentConverter x:Key="ProgressPercentConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
