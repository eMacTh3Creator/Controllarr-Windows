<Window x:Class="Controllarr.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Controllarr.App.Views"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Controllarr" Icon="/Controllarr;component/Assets/controllarr.ico" Width="1440" Height="900" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource DefaultFontFamily}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/HomeView.xaml"/>
                <ResourceDictionary Source="Views/CategoriesView.xaml"/>
                <ResourceDictionary Source="Views/SettingsView.xaml"/>
                <ResourceDictionary Source="Views/HealthView.xaml"/>
                <ResourceDictionary Source="Views/LogView.xaml"/>
                <ResourceDictionary Source="Views/SimpleViews.xaml"/>
                <ResourceDictionary Source="Views/RssView.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <DrawingImage x:Key="PauseIcon"><DrawingImage.Drawing><GeometryDrawing Brush="#64D7B0" Geometry="M 3,2 L 8,2 8,18 3,18 Z M 12,2 L 17,2 17,18 12,18 Z"/></DrawingImage.Drawing></DrawingImage>
            <DrawingImage x:Key="ResumeIcon"><DrawingImage.Drawing><GeometryDrawing Brush="#64D7B0" Geometry="M 3,2 L 18,10 3,18 Z"/></DrawingImage.Drawing></DrawingImage>
            <Style x:Key="NavigationList" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="6,1"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceLightBrush}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceLightBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentLightBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value></Setter>
                </Style></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Window.TaskbarItemInfo>
        <shell:TaskbarItemInfo ProgressValue="{Binding Desktop.TaskbarProgress}" ProgressState="{Binding Desktop.TaskbarState}" Description="Controllarr transfers">
            <shell:TaskbarItemInfo.ThumbButtonInfos>
                <shell:ThumbButtonInfo Description="Pause all torrents" ImageSource="{StaticResource PauseIcon}" Command="{Binding Desktop.PauseAllCommand}"/>
                <shell:ThumbButtonInfo Description="Resume all torrents" ImageSource="{StaticResource ResumeIcon}" Command="{Binding Desktop.ResumeAllCommand}"/>
            </shell:TaskbarItemInfo.ThumbButtonInfos>
        </shell:TaskbarItemInfo>
    </Window.TaskbarItemInfo>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding Desktop.AddFilesCommand}"/>
        <KeyBinding Key="M" Modifiers="Control" Command="{Binding Desktop.AddMagnetCommand}"/>
    </Window.InputBindings>
    <Grid>
        <tb:TaskbarIcon x:Name="TrayIcon" IconSource="/Controllarr;component/Assets/controllarr.ico" TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick">
            <tb:TaskbarIcon.TrayToolTip>
                <Border Background="{StaticResource SurfaceBrush}" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                    <StackPanel><TextBlock Text="Controllarr" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TrayTorrentSummary}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding DownloadSpeedFormatted, StringFormat=Download: {0}}"/>
                        <TextBlock Text="{Binding UploadSpeedFormatted, StringFormat=Upload: {0}}"/>
                        <TextBlock Text="{Binding TrayStatusLine}"/>
                    </StackPanel>
                </Border>
            </tb:TaskbarIcon.TrayToolTip>
            <tb:TaskbarIcon.ContextMenu><ContextMenu>
                <MenuItem Header="Show Controllarr" Click="TrayShow_Click"/>
                <MenuItem Header="Pause all torrents" Click="TrayPause_Click"/>
                <MenuItem Header="Resume all torrents" Click="TrayResume_Click"/>
                <Separator/><MenuItem Header="Open Web UI" Click="TrayOpenWebUI_Click"/>
                <MenuItem Header="Check for updates" Click="TrayCheckForUpdates_Click"/>
                <Separator/><MenuItem Header="Exit Controllarr" Click="TrayExit_Click"/>
            </ContextMenu></tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
        <DockPanel>
            <Menu DockPanel.Dock="Top" Padding="8,3">
                <MenuItem Header="_File">
                    <MenuItem Header="Add _torrent files..." InputGestureText="Ctrl+O" Command="{Binding Desktop.AddFilesCommand}"/>
                    <MenuItem Header="Add _magnet link..." InputGestureText="Ctrl+M" Command="{Binding Desktop.AddMagnetCommand}"/>
                    <MenuItem Header="Create torrent..." Command="{Binding Desktop.CreateTorrentCommand}"/>
                    <MenuItem Header="Import from another torrent client..." Command="{Binding Desktop.ImportMigrationCommand}"/>
                    <Separator/><MenuItem Header="Export configuration backup..." Command="{Binding ExportBackupCommand}"/>
                    <MenuItem Header="Import configuration backup..." Command="{Binding ImportBackupCommand}"/>
                    <Separator/><MenuItem Header="Hide to system tray" Click="HideToTray_Click"/>
                    <MenuItem Header="E_xit" Click="TrayExit_Click"/>
                </MenuItem>
                <MenuItem Header="_Edit">
                    <MenuItem Header="Select _all shown torrents" InputGestureText="Ctrl+A" Click="SelectAll_Click"/>
                    <MenuItem Header="_Find torrents" InputGestureText="Ctrl+F" Click="Find_Click"/>
                    <MenuItem Header="Clear all filters" Command="{Binding Desktop.ClearFiltersCommand}"/>
                    <Separator/><MenuItem Header="Remove selected..." InputGestureText="Delete" Command="{Binding Desktop.RemoveSelectedCommand}"/>
                    <MenuItem Header="Copy magnet links" Command="{Binding Desktop.CopyMagnetsCommand}"/>
                </MenuItem>
                <MenuItem Header="_Transfers">
                    <MenuItem Header="Resume selected" Command="{Binding Desktop.ResumeSelectedCommand}"/>
                    <MenuItem Header="Pause selected" Command="{Binding Desktop.PauseSelectedCommand}"/>
                    <MenuItem Header="Reannounce selected" Command="{Binding Desktop.ReannounceSelectedCommand}"/>
                    <MenuItem Header="Verify downloaded files..." Command="{Binding Desktop.RecheckSelectedCommand}"/>
                    <MenuItem Header="Force start (bypass queue limits)" Command="{Binding Desktop.ForceStartSelectedCommand}"/>
                    <MenuItem Header="Return to managed queue" Command="{Binding Desktop.ClearForceStartCommand}"/>
                    <MenuItem Header="Queue position">
                        <MenuItem Header="Move to top" Command="{Binding Desktop.MoveQueueCommand}" CommandParameter="top"/>
                        <MenuItem Header="Move up" Command="{Binding Desktop.MoveQueueCommand}" CommandParameter="up"/>
                        <MenuItem Header="Move down" Command="{Binding Desktop.MoveQueueCommand}" CommandParameter="down"/>
                        <MenuItem Header="Move to bottom" Command="{Binding Desktop.MoveQueueCommand}" CommandParameter="bottom"/>
                    </MenuItem>
                    <MenuItem Header="Torrent speed limits..." Command="{Binding Desktop.SetSpeedLimitsCommand}"/>
                    <MenuItem Header="Advanced torrent controls..." Command="{Binding Desktop.SetAdvancedControlsCommand}"/>
                    <MenuItem Header="Preview / stream file..." Command="{Binding Desktop.PreviewFileCommand}"/>
                    <MenuItem Header="Edit trackers..." Command="{Binding Desktop.EditTrackersCommand}"/>
                    <Separator/><MenuItem Header="Assign category..." Command="{Binding Desktop.AssignCategoryCommand}"/>
                    <MenuItem Header="Move storage..." Command="{Binding Desktop.MoveSelectedCommand}"/>
                    <MenuItem Header="Open download folders" Command="{Binding Desktop.OpenFolderCommand}"/>
                    <Separator/><MenuItem Header="Pause all torrents" Command="{Binding Desktop.PauseAllCommand}"/>
                    <MenuItem Header="Resume all torrents" Command="{Binding Desktop.ResumeAllCommand}"/>
                </MenuItem>
                <MenuItem Header="_View">
                    <MenuItem Header="Transfers" Command="{Binding SelectTabCommand}" CommandParameter="Torrents"/>
                    <MenuItem Header="Dashboard" Command="{Binding SelectTabCommand}" CommandParameter="Home"/>
                    <MenuItem Header="Categories" Command="{Binding SelectTabCommand}" CommandParameter="Categories"/>
                    <MenuItem Header="Health" Command="{Binding SelectTabCommand}" CommandParameter="Health"/>
                    <MenuItem Header="Recovery" Command="{Binding SelectTabCommand}" CommandParameter="Recovery"/>
                    <MenuItem Header="Post-processing" Command="{Binding SelectTabCommand}" CommandParameter="PostProcessor"/>
                    <MenuItem Header="Seeding policy" Command="{Binding SelectTabCommand}" CommandParameter="Seeding"/>
                    <MenuItem Header="Log" Command="{Binding SelectTabCommand}" CommandParameter="Log"/>
                    <MenuItem Header="RSS and watch folder" Command="{Binding SelectTabCommand}" CommandParameter="Rss"/>
                </MenuItem>
                <MenuItem Header="_Tools">
                    <MenuItem Header="Settings" Command="{Binding SelectTabCommand}" CommandParameter="Settings"/>
                    <MenuItem Header="VPN status" Command="{Binding SelectTabCommand}" CommandParameter="Vpn"/>
                    <MenuItem Header="Disk space" Command="{Binding SelectTabCommand}" CommandParameter="DiskSpace"/>
                    <MenuItem Header="Recheck disk space" Command="{Binding RecheckDiskSpaceCommand}"/>
                    <MenuItem Header="Cycle listening port" Command="{Binding CyclePortCommand}"/>
                    <MenuItem Header="Open Web UI in browser" Command="{Binding OpenWebUICommand}"/>
                    <MenuItem Header="Reveal log file" Command="{Binding RevealLogFileCommand}"/>
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="User guide" Click="Help_Click"/>
                    <MenuItem Header="Check for updates" Command="{Binding CheckForUpdatesCommand}"/>
                    <MenuItem Header="About Controllarr" Click="About_Click"/>
                </MenuItem>
            </Menu>
            <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <Button Content="+ Magnet" Style="{StaticResource AccentButton}" Command="{Binding Desktop.AddMagnetCommand}" Margin="0,0,8,0"/>
                    <Button Content="Add files" Command="{Binding Desktop.AddFilesCommand}" Margin="0,0,18,0"/>
                    <Button Content="Resume" Command="{Binding Desktop.ResumeSelectedCommand}" Margin="0,0,8,0"/>
                    <Button Content="Pause" Command="{Binding Desktop.PauseSelectedCommand}" Margin="0,0,8,0"/>
                    <Button Content="Remove..." Command="{Binding Desktop.RemoveSelectedCommand}" Margin="0,0,18,0"/>
                    <Button Content="Category..." Command="{Binding Desktop.AssignCategoryCommand}"/>
                </StackPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Desktop.OperationStatus}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Cancel batch" Command="{Binding Desktop.CancelBatchCommand}" Visibility="{Binding Desktop.IsBusy, Converter={StaticResource BoolToVis}}" Padding="8,2" Margin="8,0,16,0"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="{Binding DownloadSpeedFormatted, StringFormat=Down {0}}" Foreground="{StaticResource SuccessBrush}" Margin="12,0"/>
                        <TextBlock Text="{Binding UploadSpeedFormatted, StringFormat=Up {0}}" Foreground="{StaticResource AccentLightBrush}" Margin="12,0"/>
                        <TextBlock Text="{Binding TrayListenPort, StringFormat=Port {0}}" Margin="12,0"/>
                        <TextBlock Text="{Binding VpnStatusText}" Margin="12,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="205" MinWidth="170"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{StaticResource SurfaceBrush}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="20,18,12,12"><TextBlock Text="CONTROLLARR" FontWeight="Bold" FontSize="16"/><TextBlock Text="Your transfer workspace" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel>
                        <ListBox Grid.Row="1" Style="{StaticResource NavigationList}" SelectedValuePath="Tag" SelectedValue="{Binding SelectedTab, Mode=TwoWay}">
                            <ListBoxItem Tag="Torrents">Transfers</ListBoxItem><ListBoxItem Tag="Home">Dashboard</ListBoxItem>
                            <ListBoxItem Tag="Categories">Manage categories</ListBoxItem><ListBoxItem Tag="Settings">Settings</ListBoxItem>
                            <ListBoxItem Tag="Health">Health</ListBoxItem><ListBoxItem Tag="Recovery">Recovery</ListBoxItem>
                            <ListBoxItem Tag="PostProcessor">Post-processing</ListBoxItem><ListBoxItem Tag="Seeding">Seeding policy</ListBoxItem>
                            <ListBoxItem Tag="Arr">*arr activity</ListBoxItem><ListBoxItem Tag="Log">Log</ListBoxItem>
                            <ListBoxItem Tag="Rss">RSS / watch folder</ListBoxItem>
                        </ListBox>
                        <StackPanel Grid.Row="2" Margin="16,14,16,8">
                            <TextBlock Text="CATEGORIES" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <Button Content="All categories" Click="AllCategories_Click" Style="{StaticResource SubtleButton}"/>
                            <Button Content="Uncategorized" Click="Uncategorized_Click" Style="{StaticResource SubtleButton}"/>
                        </StackPanel>
                        <ListBox x:Name="CategoryList" Grid.Row="3" Style="{StaticResource NavigationList}" ItemsSource="{Binding Desktop.CategoryNames}" SelectionChanged="CategoryList_SelectionChanged"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                    </Grid>
                </Border>
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}"/>
                <Grid Grid.Column="2">
                    <views:TorrentWorkspace x:Name="Workspace">
                        <views:TorrentWorkspace.Style><Style TargetType="views:TorrentWorkspace">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding SelectedTab}" Value="Torrents"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style></views:TorrentWorkspace.Style>
                    </views:TorrentWorkspace>
                    <ContentControl Content="{Binding}">
                        <ContentControl.Style><Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource HomeViewTemplate}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Torrents"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Categories"><Setter Property="ContentTemplate" Value="{StaticResource CategoriesViewTemplate}"/></DataTrigger>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Settings"><Setter Property="ContentTemplate" Value="{StaticResource SettingsViewTemplate}"/></DataTrigger>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Health"><Setter Property="ContentTemplate" Value="{StaticResource HealthViewTemplate}"/></DataTrigger>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Recovery"><Setter Property="ContentTemplate" Value="{StaticResource RecoveryViewTemplate}"/></DataTrigger>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="PostProcessor"><Setter Property="ContentTemplate" Value="{StaticResource PostProcessorViewTemplate}"/></DataTrigger>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Seeding"><Setter Property="ContentTemplate" Value="{StaticResource SeedingViewTemplate}"/></DataTrigger>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Arr"><Setter Property="ContentTemplate" Value="{StaticResource ArrViewTemplate}"/></DataTrigger>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Log"><Setter Property="ContentTemplate" Value="{StaticResource LogViewTemplate}"/></DataTrigger>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Rss"><Setter Property="ContentTemplate" Value="{StaticResource RssViewTemplate}"/></DataTrigger>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="DiskSpace"><Setter Property="ContentTemplate" Value="{StaticResource DiskSpaceViewTemplate}"/></DataTrigger>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="Vpn"><Setter Property="ContentTemplate" Value="{StaticResource VpnViewTemplate}"/></DataTrigger>
                            </Style.Triggers>
                        </Style></ContentControl.Style>
                    </ContentControl>
                </Grid>
            </Grid>
        </DockPanel>
        <Border Background="{StaticResource BackgroundBrush}" Visibility="{Binding IsBooting, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
                <TextBlock Text="Controllarr" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,16"/>
                <TextBlock Text="Starting your native transfer workspace..."/>
                <TextBlock Text="{Binding BootError}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,12"/>
                <Button Content="Exit" Click="TrayExit_Click" Margin="0,12"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
