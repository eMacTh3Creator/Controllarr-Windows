<Window x:Class="Controllarr.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="Controllarr"
        Width="1320" Height="860"
        MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <!-- ── System tray icon ─────────────────────────────────── -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="/Assets/controllarr.ico"
                        ToolTipText="Controllarr"
                        TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show Controllarr" Click="TrayShow_Click" FontWeight="Bold"/>
                    <MenuItem Header="Open Web UI in Browser" Command="{Binding OpenWebUICommand}"/>
                    <MenuItem Header="Check for Updates…" Command="{Binding CheckForUpdatesCommand}"/>
                    <Separator/>
                    <MenuItem Header="Exit" Click="TrayExit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- ── Embedded web UI ──────────────────────────────────── -->
        <wv2:WebView2 x:Name="WebHost" />

        <!-- ── Boot / status overlay (shown until the UI is ready) ─ -->
        <Grid x:Name="BootOverlay"
              Panel.ZIndex="100"
              Visibility="{Binding IsBooting, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource BackgroundBrush}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Controllarr"
                               Style="{StaticResource HeaderText}"
                               HorizontalAlignment="Center"
                               FontSize="32"
                               Margin="0,0,0,16"/>
                    <ProgressBar IsIndeterminate="True"
                                 Width="240" Height="4"
                                 Margin="0,0,0,12"/>
                    <TextBlock Text="Starting engine and web interface…"
                               Style="{StaticResource SecondaryText}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding BootError}"
                               Foreground="{StaticResource ErrorBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               MaxWidth="460"
                               Visibility="{Binding BootError, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
